<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="actionBarSize">@dimen/compact_action_bar_size</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:colorBackground">@color/appBackground</item>
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="colorBackgroundFloating">@color/appBackgroundFloating</item>
        <item name="android:textColorSecondary">@color/appThemeTextColorSecondary</item>

        <item name="actionBarTheme">@style/AppTheme.AppBarOverlay</item>

        <item name="textFormatBarStyle">@style/TextFormatBar</item>
        <item name="recyclerViewScrollbarStyle">@style/RecyclerViewScrollbar</item>

        <item name="iconColor">@color/iconColor</item>
        <item name="iconColorOpaque">@color/iconColorText</item>

        <item name="ircColors">@style/AppTheme.IRCColors</item>

        <item name="actionBarTextColorPrimary">@color/abc_primary_text_material_dark</item>
        <item name="actionBarTextColorSecondary">@color/abc_secondary_text_material_dark</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.NoActionBar.OpaqueStatusBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">?attr/actionBarTextColorPrimary</item>
        <item name="android:textColorSecondary">?attr/actionBarTextColorSecondary</item>
    </style>

    <style name="AppTheme.LightAppBarOverlay" parent="ThemeOverlay.AppCompat.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="AppTheme.Widget.Button.Colored" parent="Widget.AppCompat.Button.Colored" />

    <style name="AppTheme.Spinner" parent="Widget.AppCompat.EditText" />
    
    <style name="AppTheme.IRCColors">
        <item name="colorBlack">@color/ircBlack</item>
        <item name="colorWhite">@color/ircWhite</item>
        <item name="colorBlue">@color/ircBlue</item>
        <item name="colorGreen">@color/ircGreen</item>
        <item name="colorLightRed">@color/ircLightRed</item>
        <item name="colorBrown">@color/ircBrown</item>
        <item name="colorPurple">@color/ircPurple</item>
        <item name="colorOrange">@color/ircOrange</item>
        <item name="colorYellow">@color/ircYellow</item>
        <item name="colorLightGreen">@color/ircLightGreen</item>
        <item name="colorCyan">@color/ircCyan</item>
        <item name="colorLightCyan">@color/ircLightCyan</item>
        <item name="colorLightBlue">@color/ircLightBlue</item>
        <item name="colorPink">@color/ircPink</item>
        <item name="colorGray">@color/ircGray</item>
        <item name="colorLightGray">@color/ircLightGray</item>

        <item name="colorTimestamp">@color/messageTimestamp</item>
        <item name="colorStatusText">@color/messageStatusText</item>
        <item name="colorDisconnected">@color/messageDisconnected</item>
        <item name="colorSenderFallbackColor">?attr/colorBlue</item>
        <item name="colorTopic">@color/messageTopic</item>

        <item name="colorMemberOwner">@color/memberOwner</item>
        <item name="colorMemberAdmin">@color/memberAdmin</item>
        <item name="colorMemberOp">@color/memberOp</item>
        <item name="colorMemberHalfOp">@color/memberHalfOp</item>
        <item name="colorMemberVoice">@color/memberVoice</item>
        <item name="colorMemberNormal">@color/memberNormal</item>
    </style>

    <style name="Icon">
        <item name="tint">?attr/iconColor</item>
        <item name="tintMode">src_in</item>
    </style>

    <style name="Icon.Opaque">
        <item name="tint">?attr/iconColorOpaque</item>
    </style>

    <style name="EditServerIcon" parent="Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentStart">true</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="EditServerIcon.TextInput" parent="EditServerIcon">
        <item name="android:layout_alignParentTop">true</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="EditServerTextInput" parent="Widget.Design.TextInputLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentStart">true</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_marginStart">56dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <style name="EditServerTextInput.ExtraAction" parent="EditServerTextInput">
        <item name="android:layout_marginEnd">56dp</item>
    </style>

    <style name="BaseEditServerExtraAction" parent="Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentTop">true</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:background">?selectableItemBackgroundBorderless</item>
    </style>

    <style name="EditServerExtraAction" parent="BaseEditServerExtraAction">
        <item name="android:layout_alignParentEnd">true</item>
    </style>

    <style name="EditServerItemContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/add_server_item_spacing</item>
    </style>

    <style name="MessageFormatSettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <style name="MessageFormatSettingsTextInputLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">@dimen/activity_horizontal_margin_s4</item>
        <item name="android:layout_marginRight">@dimen/activity_horizontal_margin_s4</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="MessageFormatSettingsExampleText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">@dimen/activity_horizontal_margin</item>
        <item name="android:layout_marginRight">@dimen/activity_horizontal_margin</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Body1</item>
    </style>

    <style name="EditTextWithExpandIcon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingEnd">32dp</item>
    </style>

    <style name="EditTextExpandIconButton" parent="Icon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">-40dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:layout_marginEnd">-4dp</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:padding">4dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="TextFormatBar">
        <item name="android:padding">4dp</item>
        <item name="android:background">?attr/colorBackgroundFloating</item>
    </style>

    <style name="TextFormatBarButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_marginRight">2dp</item>
        <item name="android:background">@drawable/format_item_background</item>
        <item name="tint">?attr/iconColorOpaque</item>
    </style>

    <style name="RecyclerViewScrollbar">
        <item name="android:padding">8dp</item>
        <item name="scrollbarDrawable">@drawable/recyclerview_scrollbar</item>
        <item name="scrollbarTint">@color/recyclerview_scrollbar_tint_list</item>
        <item name="minScrollbarHeight">24dp</item>
        <item name="letterDrawable">@drawable/recyclerview_scrollbar_letter</item>
        <item name="letterTint">?attr/colorAccent</item>
        <item name="letterTextAppearance">@style/ScrollbarLetterTextAppearance</item>
    </style>

    <style name="ScrollbarLetterTextAppearance">
        <item name="android:textSize">32dp</item>
        <item name="android:textColor">#fff</item>
    </style>

    <style name="BottomSheetIconTextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#DE000000</item>
    </style>

    <style name="MaterialColorPickerDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowMinWidthMinor">16dp</item>
        <item name="android:windowMinWidthMajor">16dp</item>
    </style>

    <!-- Near-black, single-hue base used by the Terminal appearance preset. -->
    <style name="AppTheme.Terminal" parent="AppTheme">
        <item name="colorPrimary">#FF003B00</item>
        <item name="colorPrimaryDark">#FF001B00</item>
        <item name="colorAccent">#FF39FF14</item>
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:windowBackground">#FF000000</item>
        <item name="colorBackgroundFloating">#FF071007</item>
        <item name="android:textColorPrimary">@color/preset_terminal_text_primary</item>
        <item name="android:textColorSecondary">@color/preset_terminal_text_secondary</item>
        <item name="iconColor">#FF39FF14</item>
        <item name="iconColorOpaque">#FF39FF14</item>
        <item name="actionBarTextColorPrimary">#FF39FF14</item>
        <item name="actionBarTextColorSecondary">#FFA5D6A7</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="ircColors">@style/AppTheme.Terminal.IRCColors</item>
    </style>

    <style name="AppTheme.Terminal.NoActionBar" parent="AppTheme.Terminal">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.Terminal.IRCColors" parent="AppTheme.IRCColors">
        <item name="colorBlack">#FF39FF14</item>
        <item name="colorWhite">#FF39FF14</item>
        <item name="colorBlue">#FF39FF14</item>
        <item name="colorGreen">#FF39FF14</item>
        <item name="colorLightRed">#FF39FF14</item>
        <item name="colorBrown">#FF39FF14</item>
        <item name="colorPurple">#FF39FF14</item>
        <item name="colorOrange">#FF39FF14</item>
        <item name="colorYellow">#FF39FF14</item>
        <item name="colorLightGreen">#FF39FF14</item>
        <item name="colorCyan">#FF39FF14</item>
        <item name="colorLightCyan">#FF39FF14</item>
        <item name="colorLightBlue">#FF39FF14</item>
        <item name="colorPink">#FF39FF14</item>
        <item name="colorGray">#FFA5D6A7</item>
        <item name="colorLightGray">#FFA5D6A7</item>
        <item name="colorTimestamp">#FF7CBF7C</item>
        <item name="colorStatusText">#FFA5D6A7</item>
        <item name="colorDisconnected">#FF39FF14</item>
        <item name="colorSenderFallbackColor">#FF39FF14</item>
        <item name="colorTopic">#FF39FF14</item>
        <item name="colorMemberOwner">#FF39FF14</item>
        <item name="colorMemberAdmin">#FF39FF14</item>
        <item name="colorMemberOp">#FF39FF14</item>
        <item name="colorMemberHalfOp">#FF39FF14</item>
        <item name="colorMemberVoice">#FF39FF14</item>
        <item name="colorMemberNormal">#FF39FF14</item>
    </style>

    <!-- Light high-contrast base; roles also remain identifiable by IRC prefixes and text style. -->
    <style name="AppTheme.HighContrast" parent="AppTheme">
        <item name="colorPrimary">#FF003B73</item>
        <item name="colorPrimaryDark">#FF00284F</item>
        <item name="colorAccent">#FFA64B00</item>
        <item name="android:colorBackground">#FFFFFFFF</item>
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="colorBackgroundFloating">#FFFFFFFF</item>
        <item name="android:textColorPrimary">@color/preset_high_contrast_text_primary</item>
        <item name="android:textColorSecondary">@color/preset_high_contrast_text_secondary</item>
        <item name="iconColor">#FF000000</item>
        <item name="iconColorOpaque">#FF000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="ircColors">@style/AppTheme.HighContrast.IRCColors</item>
    </style>

    <style name="AppTheme.HighContrast.NoActionBar" parent="AppTheme.HighContrast">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#FF00284F</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.HighContrast.IRCColors" parent="AppTheme.IRCColors">
        <item name="colorBlack">#FF000000</item>
        <item name="colorWhite">#FFFFFFFF</item>
        <item name="colorBlue">#FF005A8D</item>
        <item name="colorGreen">#FF006B5F</item>
        <item name="colorLightRed">#FFA63D20</item>
        <item name="colorBrown">#FF6B3E26</item>
        <item name="colorPurple">#FF6B3D8E</item>
        <item name="colorOrange">#FFA64B00</item>
        <item name="colorYellow">#FF765F00</item>
        <item name="colorLightGreen">#FF006B5F</item>
        <item name="colorCyan">#FF006878</item>
        <item name="colorLightCyan">#FF006878</item>
        <item name="colorLightBlue">#FF005A8D</item>
        <item name="colorPink">#FF8A3564</item>
        <item name="colorGray">#FF4A4A4A</item>
        <item name="colorLightGray">#FF5E5E5E</item>
        <item name="colorTimestamp">#FF303030</item>
        <item name="colorStatusText">#FF202020</item>
        <item name="colorDisconnected">#FF7A2E00</item>
        <item name="colorSenderFallbackColor">#FF005A8D</item>
        <item name="colorTopic">#FF000000</item>
        <item name="colorMemberOwner">#FFA64B00</item>
        <item name="colorMemberAdmin">#FF6B3D8E</item>
        <item name="colorMemberOp">#FF005A8D</item>
        <item name="colorMemberHalfOp">#FF006878</item>
        <item name="colorMemberVoice">#FF6B3E26</item>
        <item name="colorMemberNormal">#FF000000</item>
    </style>

</resources>
